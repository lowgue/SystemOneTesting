CLEF_SERVER_METADATA=.artifacts/clef-server.json
# Optional hosted backend. Never commit real credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Executable with Clef/System One support (not merely any llama-server build).
LLAMA_SERVER=
